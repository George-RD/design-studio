  "precedence": [
    {
      "rank": 1,
      "id": "document-page-or-print",
      "signal": "The requested primary output is a paginated page, print or PDF artifact rather than an interactive surface with incidental export.",
      "allowedModes": [
        "document-create",
        "document-review"
      ]
    },
    {
      "rank": 2,
      "id": "explicit-overhaul",
      "signal": "The user explicitly asks to replace or materially reinvent the current interactive visual world.",
      "allowedModes": [
        "overhaul"
      ]
    },
    {
      "rank": 3,
      "id": "accepted-world-extension",
      "signal": "The request adds a surface, feature or reusable pattern inside accepted visual authority.",
      "allowedModes": [
        "extend"
      ]
    },
    {
      "rank": 4,
      "id": "audit-or-polish-only",
      "signal": "The request audits, reviews, fixes, polishes or extracts candidate conventions from an interactive surface without replacing its visual world.",
      "allowedModes": [
        "polish"
      ]
    },
    {
      "rank": 5,
      "id": "new-interactive-surface",
      "signal": "The request creates a new interactive visual world and no higher-ranked rule applies.",
      "allowedModes": [
        "create"
      ]
    }
  ],
